<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Royal Caps | Shop</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f4f4f4;
}

header{
    background:#000;
    padding:20px 8%;
}

nav{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo{
    color:gold;
    font-size:32px;
    font-weight:bold;
}

nav ul{
    display:flex;
    list-style:none;
}

nav ul li{
    margin-left:25px;
}

nav ul li a{
    color:white;
    text-decoration:none;
}

.hero{
    text-align:center;
    padding:60px 20px;
    background:white;
}

.hero h1{
    font-size:50px;
    margin-bottom:10px;
}

.hero p{
    color:#666;
}

.products{
    padding:60px 8%;
}

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:25px;
}

.card{
    background:white;
    border-radius:10px;
    overflow:hidden;
    box-shadow:0 5px 15px rgba(0,0,0,.1);
    transition:0.3s;
}

.card:hover{
    transform:translateY(-8px);
}

.card img{
    width:100%;
    height:320px;
    object-fit:cover;
}

.info{
    padding:20px;
    text-align:center;
}

.price{
    color:#c9a227;
    font-size:24px;
    font-weight:bold;
    margin:10px 0;
}

.btn{
    background:black;
    color:white;
    border:none;
    padding:12px 25px;
    cursor:pointer;
    border-radius:5px;
}

.btn:hover{
    background:gold;
    color:black;
}

footer{
    background:black;
    color:white;
    text-align:center;
    padding:20px;
}
</style>
</head>
<body>

<header>
<nav>
<div class="logo">ROYAL CAPS</div>

<ul>
<li><a href="index.html">Home</a></li>
<li><a href="shop.html">Shop</a></li>
<li><a href="cart.html">Cart</a></li>
</ul>
</nav>
</header>

<section class="hero">
<h1>Luxury Face Caps</h1>
<p>Discover our premium collection.</p>
</section>

<section class="products">

<div class="grid">

<div class="card">
<img src="https://images.unsplash.com/photo-1588850561407-ed78c282e89b?auto=format&fit=crop&w=800&q=80">
<div class="info">
<h3>Black Signature Cap</h3>
<p class="price">$120</p>
<button class="btn" onclick="addToCart('Black Signature Cap',120)">Add to Cart</button>
</div>
</div>

<div class="card">
<img src="https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?auto=format&fit=crop&w=800&q=80">
<div class="info">
<h3>Royal Navy Cap</h3>
<p class="price">$150</p>
<button class="btn" onclick="addToCart('Royal Navy Cap',150)">Add to Cart</button>
</div>
</div>

<div class="card">
<img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=800&q=80">
<div class="info">
<h3>Gold Edition Cap</h3>
<p class="price">$180</p>
<button class="btn" onclick="addToCart('Gold Edition Cap',180)">Add to Cart</button>
</div>
</div>

<div class="card">
<img src="https://images.unsplash.com/photo-1521369909029-2afed882baee?auto=format&fit=crop&w=800&q=80">
<div class="info">
<h3>Elite Street Cap</h3>
<p class="price">$200</p>
<button class="btn" onclick="addToCart('Elite Street Cap',200)">Add to Cart</button>
</div>
</div>

</div>

</section>

<footer>
<p>© 2026 Royal Caps. All Rights Reserved.</p>
</footer>

<script>
function addToCart(name, price){

let cart = JSON.parse(localStorage.getItem("cart")) || [];

let item = cart.find(product => product.name === name);

if(item){
    item.quantity += 1;
}else{
    cart.push({
        name: name,
        price: price,
        quantity: 1
    });
}

localStorage.setItem("cart", JSON.stringify(cart));

alert(name + " added to cart!");
}
</script>

</body>
</html>
